{
  "name": "biokeeper",
  "version": "1.0.0",
  "description": "ESP32 vegetable maintenance dashboard with UV control, sensors, and a modern React UI.",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=@biokeeper/backend",
    "dev:frontend": "npm run dev --workspace=@biokeeper/frontend",
    "start": "npm run start --workspace=@biokeeper/backend",
    "build": "npm run build --workspace=@biokeeper/frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}